# Supabase Configuration
# Obtén estas credenciales en tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (OPCIONAL: SOLO para Server Actions o Webhooks seguros del backend, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Información general del sitio
NEXT_PUBLIC_SITE_URL=https://diversamente.vercel.app
NEXT_PUBLIC_SITE_NAME=Diversamente
NEXT_PUBLIC_CONTACT_EMAIL=fundiversamente@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+57 318 571 39 91
NEXT_PUBLIC_CONTACT_LOCATION="Bogotá, Colombia"
